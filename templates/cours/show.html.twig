{% extends 'base.html.twig' %}

{% block title %}Cours{% endblock %}

{% block body %}
    <h1>Cours</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cour.id }}</td>
            </tr>
            <tr>
                <th>Debut</th>
                <td>{{ cour.debut ? cour.debut|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Fin</th>
                <td>{{ cour.fin ? cour.fin|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Devoirs</th>
                <td>{{ cour.devoirs }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ cour.statut ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('cours_index') }}">back to list</a>

    <a href="{{ path('cours_edit', {'id': cour.id}) }}">edit</a>

    {{ include('cours/_delete_form.html.twig') }}
{% endblock %}
